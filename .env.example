# Dev-only values. Copy to .env and change for anything non-local.
# docker compose reads POSTGRES_* from .env automatically (defaults below apply if absent).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=receipts

# Used by the app and Alembic when running outside Docker (export it in your shell).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/receipts

# Where uploaded images are stored, max upload size, and allowed browser origins (comma-separated; empty = no CORS).
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
CORS_ORIGINS=http://localhost:3000
