{
  "info": {
    "name": "Receipt OCR & Analytics v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/health"
      }
    },
    {
      "name": "Upload Sample",
      "request": {
        "method": "POST",
        "url": "http://localhost:8000/api/v1/receipts/upload",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "docs/samples/receipt1.png"
            }
          ]
        }
      }
    },
    {
      "name": "Analytics Summary",
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/api/v1/analytics/summary"
      }
    },
    {
      "name": "By Vendor",
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/api/v1/analytics/by-vendor"
      }
    },
    {
      "name": "By Category",
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/api/v1/analytics/by-category"
      }
    }
  ]
}